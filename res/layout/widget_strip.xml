<?xml version="1.0" encoding="utf-8"?>
<!-- One row: small rounded art, track, controls. The text gives way first when narrow. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF1E1E1E"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="6dp">

        <ImageView
            android:id="@+id/art"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/art_round"
            android:clipToOutline="true"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:src="@drawable/placeholder" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="2dp">

            <TextView
                android:id="@+id/title"
                style="@style/Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/idle_title"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/artist"
                style="@style/Artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/idle_subtitle"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/prev"
            style="@style/Btn"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@string/previous"
            android:padding="6dp"
            android:src="@drawable/ic_prev" />

        <ImageButton
            android:id="@+id/play"
            style="@style/Btn"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@string/play"
            android:padding="3dp"
            android:src="@drawable/ic_play" />

        <ImageButton
            android:id="@+id/next"
            style="@style/Btn"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@string/next"
            android:padding="6dp"
            android:src="@drawable/ic_next" />
    </LinearLayout>
</FrameLayout>
