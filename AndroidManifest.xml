<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.nowplaying.widget"
    android:versionCode="1"
    android:versionName="1.0">

    <!-- minSdk 31: sized RemoteViews, rounded widget corners, clipToOutline in widget layouts. -->
    <uses-sdk android:minSdkVersion="31" android:targetSdkVersion="34" />

    <!-- Needed to resolve Spotify's launch intent (package visibility). -->
    <queries>
        <package android:name="com.spotify.music" />
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
        android:allowBackup="false"
        android:supportsRtl="true">

        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver android:name=".NowPlayingWidget" android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

        <!-- Notification access is the only way a third-party app may read another app's
             media session (track, album art, playback state). Notifications themselves are ignored. -->
        <service android:name=".MediaListener" android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
